import frappe
from frappe.utils import get_datetime, now_datetime


def send_contest_start_notifications():
	"""Send an email when a contest starts today."""
	now = now_datetime()

	contests = frappe.get_all(
		"Contest",
		filters={
			"start_date": [">=", now.replace(hour=0, minute=0, second=0)],
			"start_date": ["<=", now.replace(hour=23, minute=59, second=59)],
		},
		fields=["name"],
	)

	for contest in contests:
		contest_doc = frappe.get_doc("Contest", contest.name)

		users = frappe.get_all(
			"User",
			filters={
				"enabled": 1,
			},
			fields=["email"],
		)

		template = frappe.get_doc(
			"Email Template",
			"Contest Starts Today",
		)

		context = contest_doc.as_dict()

		subject = frappe.render_template(
			template.subject,
			context,
		)

		message = frappe.render_template(
			template.response_html,
			context,
		)

		recipients = [
			user.email
			for user in users
			if user.email
		]

		if recipients:
			frappe.sendmail(
				recipients=recipients,
				subject=subject,
				message=message,
			)

